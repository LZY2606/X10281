{
  "caseId": "half-closed-direction",
  "title": "半关闭帧与方向表混淆：half-closed(local) 后 client 再发 HEADERS；并把 s2c 动态索引当 c2s 用",
  "mutates": {
    "frameOffsetOctets": 43,
    "direction": "s2c",
    "replacementNote": "在 stream 关闭后追加 c2s HEADERS（复用已关闭 stream 1）"
  },
  "expects": [
    {
      "ruleId": "R-STREAM-REUSE",
      "scope": "stream",
      "note": "closed 后再发 HEADERS = STREAM_CLOSED，stream 错误不升级为连接错误"
    },
    {
      "ruleId": "R-HPACK-DIRECTION",
      "scope": "connection",
      "note": "附加材料：c2s 引用仅存在于 s2c 动态表的索引（在独立 capture branch2 中体现）"
    }
  ],
  "coordinateSystem": {
    "frameOffset": "octet per direction",
    "streamId": "uint31",
    "range": "half-open [start,end)"
  },
  "frames": [
