    },
    {
      "id": "f24_c2s",
      "bytesHex": "00000c01000000000182bd8154076162632d313233",
      "direction": "c2s",
      "offsetOctets": 24,
      "seq": 4,
      "note": "HEADERS stream 1 起始：:method GET(idx2) :scheme https(idx61) :path /(idx1) + 字面 x-trace 入动态表，无 END_HEADERS"
