      "bytesHex": "000006040000000000000100000100",
      "direction": "c2s",
      "offsetOctets": 0,
      "seq": 0,
      "note": "client SETTINGS：提议 c2s 方向 HEADER_TABLE_SIZE=256 octets（生效点待 ACK）"
    },
    {
      "id": "f0_s2c",
      "bytesHex": "000000040000000000",
      "direction": "s2c",
      "offsetOctets": 0,
      "seq": 1,
      "note": "server SETTINGS：s2c 方向保持默认（空 SETTINGS）"
    },
    {
      "id": "f9_s2c",
      "bytesHex": "000000040100000000",
      "direction": "s2c",
      "offsetOctets": 9,
      "seq": 2,
      "note": "server ACK client SETTINGS → c2s 256 octet 上限生效"
    },
    {
      "id": "f15_c2s",
      "bytesHex": "000000040100000000",
      "direction": "c2s",
      "offsetOctets": 15,
      "seq": 3,
